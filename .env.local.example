NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# From Supabase: Project Settings -> API -> service_role key. Keep this secret —
# never share it, never commit it, never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Your own password for the /admin page
ADMIN_PASSWORD=choose_a_strong_password

# Any long random string, used to sign your admin session (not the password itself)
ADMIN_SESSION_SECRET=any_long_random_string

# From resend.com: API Keys -> Create API Key. Optional — approval/verification
# emails just won't send if this is missing, nothing else breaks.
RESEND_API_KEY=your_resend_api_key

# Your real, permanent site URL (the vercel.app one for now, luupa.net later).
# Used so emailed links (like password reset) always point to the live site,
# never to whatever localhost you happened to be testing from.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Authenticates Vercel Cron's hourly calls to /api/send-reminders (booking
# reminder emails) — Vercel automatically sends this as a Bearer token when
# the same CRON_SECRET is set in the project's env vars. Generate one with
# `openssl rand -hex 32`.
CRON_SECRET=any_long_random_string
